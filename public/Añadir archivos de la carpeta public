.user-actions { display: flex; align-items: center; gap: 10px; }
.user-chip { padding: 8px 12px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: 0.84rem; font-weight: 750; }

.shell { max-width: 1320px; margin: 0 auto; padding: 28px 24px 72px; }
.page-head { display: flex; justify-content: space-between; align-items: end; gap: 18px; margin-bottom: 20px; }
.eyebrow { margin: 0 0 6px; color: var(--green); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.12em; font-weight: 900; }
h1, h2, h3, p { margin-top: 0; }
h1 { margin-bottom: 7px; font-size: clamp(1.8rem, 3vw, 2.7rem); line-height: 1.06; letter-spacing: -0.04em; }
h2 { margin-bottom: 6px; font-size: 1.2rem; letter-spacing: -0.02em; }
h3 { margin-bottom: 5px; font-size: 1rem; }
.page-head p { color: var(--muted); margin-bottom: 0; }

.tabs { display: flex; gap: 7px; flex-wrap: wrap; padding: 6px; border-radius: 15px; background: var(--surface); border: 1px solid var(--line); }
.tab { border: 0; border-radius: 11px; background: transparent; color: var(--muted); padding: 10px 13px; font-weight: 800; }
.tab.active { color: white; background: var(--green); }
.view { display: none; }
.view.active { display: block; }

.grid { display: grid; gap: 16px; }
.grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.layout { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(320px, 0.85fr); gap: 18px; align-items: start; }
.stack { display: grid; gap: 16px; }

.card { background: var(--surface); border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow); }
.card-body { padding: 20px; }
.card-head { display: flex; justify-content: space-between; align-items: start; gap: 14px; padding: 19px 20px 0; }
.card-head p { margin: 0; color: var(--muted); font-size: 0.9rem; }
.card-head + .card-body { padding-top: 14px; }

.hero { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 22px; padding: 24px; border-radius: 25px; color: white; background: linear-gradient(135deg, var(--green), var(--green-dark)); box-shadow: var(--shadow); }
.gauge { width: 112px; height: 112px; border-radius: 50%; display: grid; place-items: center; text-align: center; border: 11px solid rgba(255,255,255,.22); background: rgba(255,255,255,.1); }
.gauge strong { display: block; font-size: 2.25rem; line-height: 1; }
.gauge small { display: block; opacity: .78; font-weight: 800; margin-top: 4px; }
.hero h2 { font-size: 1.55rem; margin-bottom: 8px; }
.hero p { margin: 0; opacity: .85; max-width: 680px; line-height: 1.55; }
.goal-count { text-align: center; min-width: 125px; padding: 14px; border-radius: 17px; background: rgba(255,255,255,.13); }
.goal-count strong { display: block; font-size: 2rem; }
.goal-count span, .goal-count b { display: block; font-size: .82rem; }
.goal-count span { opacity: .72; }

.metric { padding: 17px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); }
.metric span { display: block; color: var(--muted); font-size: .82rem; font-weight: 750; }
.metric strong { display: block; margin: 7px 0 4px; font-size: 1.8rem; line-height: 1; }
.metric small { color: var(--muted); }

.week-strip { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 10px; }
.day-card { min-height: 150px; padding: 14px; border-radius: 17px; border: 1px solid var(--line); background: var(--surface-2); display: flex; flex-direction: column; gap: 8px; }
.day-card.today { border-color: var(--green); box-shadow: inset 0 0 0 1px var(--green); }
.day-card .day { color: var(--muted); font-weight: 850; font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; }
