.badge.off { background: var(--red-soft); color: var(--red); }
.notice { padding: 13px 15px; border-radius: 14px; border: 1px solid var(--line); background: var(--blue-soft); color: var(--blue); margin-bottom: 16px; }
.notice.error { background: var(--red-soft); color: var(--red); border-color: #f1c9cd; }
.notice.success { background: var(--green-soft); color: var(--green-dark); border-color: #c8e5dd; }

.zone-table { display: grid; gap: 8px; }
.zone-row { display: grid; grid-template-columns: 1.45fr 1fr 1fr auto; gap: 9px; align-items: end; padding: 11px; border-radius: 14px; background: var(--surface-2); border: 1px solid var(--line); }
.zone-row input { margin-top: 0; }

.session-editor { display: grid; gap: 13px; }
.session-row { display: grid; grid-template-columns: 110px 1.1fr 1.9fr 85px auto; gap: 9px; align-items: center; padding: 12px; border: 1px solid var(--line); border-radius: 15px; background: var(--surface-2); }
