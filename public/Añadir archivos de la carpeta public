.modal-backdrop { position: fixed; inset: 0; z-index: 100; padding: 18px; background: rgba(11, 30, 30, .52); display: grid; place-items: center; }
.modal { width: min(720px, 100%); max-height: 90vh; overflow: auto; border-radius: 22px; background: var(--surface); box-shadow: 0 30px 90px rgba(0,0,0,.25); }
